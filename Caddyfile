valencianismo.com {
    root * /srv
    file_server
    encode zstd gzip

    # ⚡ OPT-7: Cache 1 año para assets inmutables (con versión en URL)
    @static-immutable {
        file
        path *.png *.jpg *.jpeg *.ico *.gif *.svg *.css *.js *.ttf *.woff2 *.webp *.mp3 *.ogg
    }
    header @static-immutable Cache-Control "public, max-age=31536000, immutable"

    # ⚡ OPT-7: Cache corta para JSON/feeds (se actualizan frecuentemente)
    @dynamic {
        file
        path *.json *.txt
    }
    header @dynamic Cache-Control "public, max-age=300, stale-while-revalidate=60"

    # ⚡ OPT-7: HTML nunca cacheado (siempre fresco)
    @html {
        file
        path *.html
    }
    header @html Cache-Control "no-cache, must-revalidate"

    # ⚡ Cabeceras de seguridad y rendimiento
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer-when-downgrade"
    }

    # Proxy del stream de audio
    reverse_proxy /stream icecast:8000
    reverse_proxy /status-json.xsl icecast:8000
}
