{
  "name": "MP3 AI Tagger",
  "nodes": [
    {
      "parameters": {},
      "id": "eecf2c8f-3d6d-495f-b5b4-d50c7cd768d8",
      "name": "When clicking \"Test workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "command": "find /mp3 -type f -name \"*.mp3\""
      },
      "id": "execute-find",
      "name": "Find MP3s",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "splitIntoItems",
        "separator": "\n",
        "itemToSend": "stdout"
      },
      "id": "split",
      "name": "Split Lines",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "prompt": "={{ $json.stdout }}",
        "messages": {
          "messageValues": [
            {
              "message": "Extract the artist and song title from this file path. Return ONLY valid JSON with keys 'artist' and 'title'. If artist is unknown, use 'Desconocido'. Path: {{$json.stdout}}"
            }
          ]
        }
      },
      "id": "ai-node",
      "name": "Google Gemini (Free)",
      "type": "n8n-nodes-base.googleGenerativeAi",
      "typeVersion": 1,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "string": true
        }
      },
      "id": "parse-json",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.jsonParse",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "command": "=python3 /home/node/tagger.py \"{{ $('Split Lines').item.json.stdout }}\" \"{{ $json.artist }}\" \"{{ $json.title }}\""
      },
      "id": "execute-tag",
      "name": "Tag MP3",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1320,
        300
      ]
    }
  ],
  "connections": {
    "When clicking \"Test workflow\"": {
      "main": [
        [
          {
            "node": "Find MP3s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find MP3s": {
      "main": [
        [
          {
            "node": "Split Lines",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Lines": {
      "main": [
        [
          {
            "node": "OpenAI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI": {
      "main": [
        [
          {
            "node": "Parse JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse JSON": {
      "main": [
        [
          {
            "node": "Tag MP3",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
